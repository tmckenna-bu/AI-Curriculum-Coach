import React, { useState, useEffect, useRef } from 'react';
import { Send, Lightbulb, BarChart3, RefreshCw, FileText } from 'lucide-react';

const NGSSAICoach = () => {
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  const [teacherContext, setTeacherContext] = useState({
    gradeLevel: '',
    subject: '',
    experience: '',
    name: ''
  });
  const [showSetup, setShowSetup] = useState(true);
  const [analytics, setAnalytics] = useState([]);
  const [uploadedDoc, setUploadedDoc] = useState(null);
  const [docContent, setDocContent] = useState('');
  const [showPasteArea, setShowPasteArea] = useState(false);
  const [pasteContent, setPasteContent] = useState('');
  const [librariesLoaded, setLibrariesLoaded] = useState(false);
  const messagesEndRef = useRef(null);
  const fileInputRef = useRef(null);

  // Load PDF.js and Mammoth libraries on mount
  useEffect(() => {
    const loadLibraries = () => {
      // Load PDF.js
      const pdfScript = document.createElement('script');
      pdfScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
      pdfScript.async = true;
      document.head.appendChild(pdfScript);

      // Load Mammoth
      const mammothScript = document.createElement('script');
      mammothScript.src = 'https://cdn.jsdelivr.net/npm/mammoth@1.6.0/mammoth.browser.min.js';
      mammothScript.async = true;
      document.head.appendChild(mammothScript);

      // Wait for both to load
      Promise.all([
        new Promise(resolve => { pdfScript.onload = resolve; }),
        new Promise(resolve => { mammothScript.onload = resolve; })
      ]).then(() => {
        setLibrariesLoaded(true);
      }).catch(() => {
        console.warn('Some libraries failed to load');
        setLibrariesLoaded(true); // Continue anyway
      });
    };

    loadLibraries();
  }, []);

  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  };

  useEffect(() => {
    scrollToBottom();
  }, [messages]);

  const logInteraction = (question, response) => {
    const interaction = {
      timestamp: new Date().toISOString(),
      teacherContext: teacherContext,
      question: question,
      response: response,
      category: categorizeQuestion(question)
    };
    setAnalytics(prev => [...prev, interaction]);
  };

  const categorizeQuestion = (question) => {
    const q = question.toLowerCase();
    if (q.includes('lesson') || q.includes('plan')) return 'Lesson Planning';
    if (q.includes('assess') || q.includes('test')) return 'Assessment';
    if (q.includes('engage') || q.includes('motivate')) return 'Student Engagement';
    if (q.includes('differentiat') || q.includes('scaffold')) return 'Differentiation';
    if (q.includes('standard') || q.includes('ngss')) return 'Standards Alignment';
    if (q.includes('lab') || q.includes('experiment')) return 'Inquiry & Investigation';
    return 'General Inquiry';
  };

  const extractTextFromPDF = async (file) => {
    try {
      // For PDF.js to work, we need to load it from CDN
      // In production, you'd install: npm install pdfjs-dist
      const pdfjsLib = window['pdfjs-dist/build/pdf'];
      
      if (!pdfjsLib) {
        throw new Error('PDF.js not loaded');
      }

      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

      const arrayBuffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      
      let fullText = '';
      
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const textContent = await page.getTextContent();
        const pageText = textContent.items.map(item => item.str).join(' ');
        fullText += pageText + '\n\n';
      }
      
      return fullText;
    } catch (error) {
      console.error('PDF extraction error:', error);
      return null;
    }
  };

  const extractTextFromWord = async (file) => {
    try {
      // For Mammoth to work, we need to load it from CDN
      // In production, you'd install: npm install mammoth
      const mammoth = window.mammoth;
      
      if (!mammoth) {
        throw new Error('Mammoth not loaded');
      }

      const arrayBuffer = await file.arrayBuffer();
      const result = await mammoth.extractRawText({ arrayBuffer });
      return result.value;
    } catch (error) {
      console.error('Word extraction error:', error);
      return null;
    }
  };

  const handleFileUpload = async (event) => {
    const file = event.target.files[0];
    if (!file) return;

    const validTypes = [
      'application/pdf',
      'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      'application/msword',
      'text/plain'
    ];

    if (!validTypes.includes(file.type)) {
      alert('Please upload a PDF, Word document (.doc, .docx), or text file.');
      return;
    }

    setUploadedDoc({
      name: file.name,
      type: file.type,
      size: file.size
    });

    addSystemMessage(`📄 Processing "${file.name}"... Please wait.`);

    let extractedText = '';

    // Handle different file types
    if (file.type === 'text/plain') {
      extractedText = await file.text();
    } else if (file.type === 'application/pdf') {
      extractedText = await extractTextFromPDF(file);
      if (!extractedText) {
        addSystemMessage(`⚠️ Unable to automatically extract text from this PDF. This might be because:\n• The PDF contains scanned images (not searchable text)\n• PDF.js library didn't load\n\nWould you like to paste the content manually instead? Click "Paste Content" button.`);
        return;
      }
    } else if (file.type.includes('word') || file.type.includes('document')) {
      extractedText = await extractTextFromWord(file);
      if (!extractedText) {
        addSystemMessage(`⚠️ Unable to automatically extract text from this Word document. The Mammoth.js library may not have loaded.\n\nWould you like to paste the content manually instead? Click "Paste Content" button.`);
        return;
      }
    }

    if (extractedText && extractedText.trim()) {
      setDocContent(extractedText);
      addSystemMessage(`✓ Successfully analyzed "${file.name}"! (${Math.round(extractedText.length / 1000)}K characters extracted)\n\nI've reviewed your curriculum unit. You can now ask me questions like:\n\n• "Give me a summary of this unit"\n• "What are the key learning objectives?"\n• "Help me understand the science in lesson 3"\n• "What prerequisite knowledge do students need?"\n• "How can I modify this for struggling learners?"\n• "Draft an email to parents about this unit"\n• "I just taught lesson 2, what's coming next?"\n\nWhat would you like to know?`);
    } else {
      addSystemMessage(`⚠️ The file was uploaded but no text could be extracted. Try using "Paste Content" instead.`);
    }
  };

  const handlePasteContent = () => {
    if (!pasteContent.trim()) {
      alert('Please paste some curriculum content first.');
      return;
    }

    setDocContent(pasteContent);
    setUploadedDoc({
      name: 'Pasted Content',
      type: 'text/plain',
      size: pasteContent.length
    });
    setShowPasteArea(false);
    setPasteContent('');
    
    addSystemMessage(`✓ Curriculum content loaded! (${Math.round(pasteContent.length / 1000)}K characters)\n\nI've reviewed your curriculum materials. You can now ask me questions like:\n\n• "Summarize this unit"\n• "What are the learning objectives?"\n• "Help me understand the science concepts"\n• "How can I adapt this for my students?"\n• "Draft a parent email about what we're learning"\n• "I'm on lesson 3, what comes next?"\n\nWhat would you like to explore?`);
  };

  const addSystemMessage = (content) => {
    const systemMessage = {
      role: 'system',
      content: content
    };
    setMessages(prev => [...prev, systemMessage]);
  };

  const removeDocument = () => {
    setUploadedDoc(null);
    setDocContent('');
    setShowPasteArea(false);
    setPasteContent('');
    addSystemMessage('Document removed. Feel free to upload a new curriculum unit or continue with general coaching questions.');
  };

  const generateCoachResponse = (userMessage) => {
    const msg = userMessage.toLowerCase();
    
    // If document is uploaded, provide curriculum-specific responses
    if (uploadedDoc || docContent) {
      if (msg.includes('summar')) {
        return `Let me help you think about summarizing this unit. Before I provide a summary, what aspects are most important for you to communicate? Are you summarizing for:\n\n• Yourself (planning purposes)?\n• Students (unit overview)?\n• Parents (what their child will learn)?\n• Colleagues (professional sharing)?\n\nAlso, what do you see as the core phenomenon or driving question of this unit?`;
      }
      
      if (msg.includes('email') || msg.includes('parent') || msg.includes('letter')) {
        return `Writing to parents about a science unit is a great way to build home-school connections. Before I help you draft this, let's think about your goals:\n\n• What's the main message you want parents to understand about this unit?\n• Are there ways parents can support learning at home?\n• Do students need any materials from home?\n• Are there safety considerations parents should know about?\n\nWhat's the most important thing you want parents to know about what their children will be learning?`;
      }
      
      if (msg.includes('modify') || msg.includes('adapt') || msg.includes('change')) {
        return `Adapting curriculum is an important professional skill. Tell me more about what you're thinking:\n\n• What specific aspects are you considering modifying?\n• What's driving this modification (student needs, time constraints, resources, etc.)?\n• What elements of the unit feel most essential to preserve?\n\nThe goal is to maintain the integrity of the three-dimensional learning while meeting your students' needs. What's prompting this adaptation?`;
      }
      
      if (msg.includes('science') || msg.includes('content') || msg.includes('concept')) {
        return `Understanding the science content deeply helps us teach more effectively. What specific concept or phenomenon are you trying to understand better?\n\n• Which lesson or section are you focusing on?\n• What's your current understanding of this concept?\n• What questions do students typically ask about this topic?\n• Are there aspects that feel unclear or that you'd like to explore more deeply?\n\nLet's dig into the science together. What concept would you like to explore?`;
      }
      
      if (msg.includes('lesson') && (msg.includes('next') || msg.includes('upcoming') || msg.includes('coming up'))) {
        return `Planning ahead is smart! You mentioned you're in the middle of the unit and thinking about upcoming lessons. \n\n• Where are you currently in the unit sequence?\n• What have students learned so far?\n• What evidence of learning have you observed?\n• What patterns in student understanding are you noticing?\n\nUnderstanding where students are now will help us think about how to prepare for what's next. What have you noticed about student learning so far?`;
      }
      
      if (msg.includes('objective') || msg.includes('goal') || msg.includes('standard')) {
        return `Let's examine the learning objectives in your unit. Looking at NGSS performance expectations:\n\n• What disciplinary core ideas are central to this unit?\n• Which science and engineering practices will students use?\n• What crosscutting concepts connect across lessons?\n\nHow do you see these three dimensions integrated in your unit? What connections are you noticing?`;
      }

      if (msg.includes('assess')) {
        return `Assessment in NGSS requires capturing three-dimensional learning. For this unit:\n\n• What evidence would show students can use the practices?\n• How will you know they understand the core ideas?\n• Can students apply crosscutting concepts to new situations?\n\nWhat does your unit include for assessment? What additional assessment opportunities might strengthen student learning?`;
      }
    }
    
    const responses = {
      lessonPlanning: [
        "That's an important question about lesson planning. Before we dive into specific strategies, I'm curious - what has been your experience with this topic in previous lessons? What worked well, and where did students seem to struggle?",
        "I see you're thinking about how to structure this lesson. Let's explore this together. What learning objectives are you hoping students will achieve by the end of this lesson? What evidence would show you they've met those objectives?",
        "Planning for this concept requires careful sequencing. What prior knowledge do your students bring to this topic? How might we build on that foundation?",
        "Let's think about the three dimensions of NGSS. For this lesson, which science and engineering practices would authentically engage students with the core ideas? What crosscutting concepts naturally emerge?"
      ],
      assessment: [
        "Assessment is crucial for understanding student learning. Rather than jumping straight to a solution, let's think about what you want to know about student understanding. What specific aspects of their learning are you most interested in assessing?",
        "That's a thoughtful question about evaluation. The NGSS emphasizes three-dimensional learning. How might you design an assessment that captures students' use of practices, their understanding of core ideas, and their application of crosscutting concepts?",
        "Before we discuss specific assessment strategies, tell me more about what you observed in class. What evidence of learning have you already noticed? What questions do you still have about what students understand?",
        "Formative assessment can be powerful. What opportunities exist in this lesson for students to show their thinking? How might you use that information to adjust your instruction in real-time?"
      ],
      engagement: [
        "Student engagement is multifaceted. What moments in your recent lessons did you notice students were most engaged? What was happening during those moments that captured their attention?",
        "That's a common challenge many teachers face. Let's think about this systematically. What do you know about your students' interests and experiences outside of school? How might we connect those to the science concepts?",
        "Engagement often comes from authentic inquiry. What questions are your students naturally curious about? How might we leverage that curiosity in this unit?",
        "Think about the phenomenon at the heart of this lesson. Is it something students can observe directly? Something they've experienced? The more tangible and relatable, the stronger the engagement tends to be."
      ],
      differentiation: [
        "Differentiation is essential for reaching all learners. Tell me about the range of learners in your classroom. What specific needs or strengths are you trying to address?",
        "That's an important consideration for diverse learners. Before we explore specific strategies, what approaches have you found effective in the past with similar students? What did you notice about how they responded?",
        "Supporting all learners requires thoughtful planning. What specific barriers to learning are you anticipating? How might we provide multiple pathways to the same learning goals?",
        "Let's think about the science practices as an entry point. Different students might engage with the same concept through different practices - some through modeling, others through data analysis. How might this flexibility support your learners?"
      ],
      standards: [
        "NGSS alignment is about integrating all three dimensions. Looking at the performance expectation you mentioned, what science practices could students use to explore this concept? Which feel most authentic to the discipline?",
        "That's a key standard for this grade level. Let's break it down together. What crosscutting concepts naturally connect to this disciplinary core idea? How do they deepen understanding?",
        "Standards alignment requires careful attention to learning progressions. How does this concept build on what students learned in previous grade levels? Where will it lead in future years?",
        "The performance expectation is the goal, but the pathway matters. What phenomena or problems could anchor this learning? What would make this feel real and relevant to your students?"
      ],
      inquiry: [
        "Inquiry-based learning is at the heart of NGSS. What question or phenomenon could drive student investigation? What would make students genuinely curious?",
        "Lab activities work best when students have genuine questions to answer. What have students wondered about related to this topic? How might we structure the investigation around their questions?",
        "Safety is paramount, of course. Beyond that, what would make this investigation feel authentic to how scientists actually work? How much could students control about the investigation design?",
        "Let's think about the role of evidence. What data will students collect? How will they analyze it? Most importantly, how will they use it to answer their question or explain the phenomenon?"
      ],
      reflection: [
        "Reflecting on your practice is valuable. What specific moments from that lesson stand out to you? What made those moments significant?",
        "That's interesting. Can you say more about what you noticed in that moment? What were students doing or saying that caught your attention?",
        "Reflection helps us grow as educators. What connections do you see between what happened in that lesson and your learning objectives? What might you do differently next time?",
        "When something doesn't go as planned, it's an opportunity to understand student thinking better. What do you think students were thinking or understanding that led to that outcome?"
      ]
    };

    if (msg.includes('lesson') || msg.includes('plan') || msg.includes('teach') || msg.includes('unit')) {
      return responses.lessonPlanning[Math.floor(Math.random() * responses.lessonPlanning.length)];
    }
    if (msg.includes('assess') || msg.includes('test') || msg.includes('quiz') || msg.includes('grade') || msg.includes('evaluat')) {
      return responses.assessment[Math.floor(Math.random() * responses.assessment.length)];
    }
    if (msg.includes('engage') || msg.includes('motivate') || msg.includes('interest') || msg.includes('boring') || msg.includes('attention')) {
      return responses.engagement[Math.floor(Math.random() * responses.engagement.length)];
    }
    if (msg.includes('differentiat') || msg.includes('scaffold') || msg.includes('ell') || msg.includes('special needs') || msg.includes('struggling')) {
      return responses.differentiation[Math.floor(Math.random() * responses.differentiation.length)];
    }
    if (msg.includes('standard') || msg.includes('ngss') || msg.includes('objective') || msg.includes('expectation') || msg.includes('dimension')) {
      return responses.standards[Math.floor(Math.random() * responses.standards.length)];
    }
    if (msg.includes('lab') || msg.includes('experiment') || msg.includes('investigation') || msg.includes('inquiry') || msg.includes('hands-on')) {
      return responses.inquiry[Math.floor(Math.random() * responses.inquiry.length)];
    }
    if (msg.includes('reflect') || msg.includes('went wrong') || msg.includes('didn\'t work') || msg.includes('struggled') || msg.includes('failed')) {
      return responses.reflection[Math.floor(Math.random() * responses.reflection.length)];
    }

    return `That's an important question, ${teacherContext.name || 'colleague'}. Before I share some ideas, I'd like to understand your context better. Can you tell me more about what prompted this question? What have you noticed or experienced that makes this a priority for you right now?`;
  };

  const handleSetupComplete = () => {
    if (teacherContext.name && teacherContext.gradeLevel) {
      setShowSetup(false);
      const welcomeMsg = {
        role: 'coach',
        content: `Welcome, ${teacherContext.name}! I'm here to support your teaching of NGSS-aligned science curriculum${teacherContext.gradeLevel ? ` at the ${teacherContext.gradeLevel} level` : ''}. 

I approach our conversations as a thought partner, not an evaluator. My goal is to help you think deeply about your practice through reflective dialogue. 

You'll notice I often respond to your questions with questions of my own - not to be difficult, but to help you develop your own professional judgment and problem-solving capabilities. This dialogic approach builds your capacity for independent decision-making.

What's on your mind today? What aspect of your science teaching would you like to explore together?`
      };
      setMessages([welcomeMsg]);
    }
  };

  const handleSend = () => {
    if (!input.trim()) return;

    const userMessage = {
      role: 'teacher',
      content: input
    };

    setMessages(prev => [...prev, userMessage]);
    const currentInput = input;
    setInput('');
    setIsTyping(true);

    setTimeout(() => {
      const response = generateCoachResponse(currentInput);
      const coachMessage = {
        role: 'coach',
        content: response
      };
      
      setMessages(prev => [...prev, coachMessage]);
      setIsTyping(false);
      logInteraction(currentInput, response);
    }, 1500);
  };

  const downloadAnalytics = () => {
    const summary = {
      teacher: teacherContext,
      totalInteractions: analytics.length,
      sessionDate: new Date().toISOString(),
      categoryBreakdown: analytics.reduce((acc, curr) => {
        acc[curr.category] = (acc[curr.category] || 0) + 1;
        return acc;
      }, {}),
      interactions: analytics
    };
    
    const dataStr = JSON.stringify(summary, null, 2);
    const dataBlob = new Blob([dataStr], { type: 'application/json' });
    const url = URL.createObjectURL(dataBlob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `ngss-coach-analytics-${new Date().toISOString().split('T')[0]}.json`;
    link.click();
  };

  const shareDataForResearch = () => {
    const summary = {
      teacher: teacherContext,
      totalInteractions: analytics.length,
      sessionDate: new Date().toISOString(),
      categoryBreakdown: analytics.reduce((acc, curr) => {
        acc[curr.category] = (acc[curr.category] || 0) + 1;
        return acc;
      }, {}),
      interactions: analytics
    };
    
    const dataStr = JSON.stringify(summary, null, 2);
    
    navigator.clipboard.writeText(dataStr).then(() => {
      alert('✓ Pilot data copied to clipboard!\n\nThank you for contributing to this research. Please email the copied data to:\n\ninfo@ngssphenomena.com\n\nYour feedback helps us refine this tool to better support science educators.');
    }).catch(() => {
      alert('Unable to copy automatically. Please use the "Export for Me" button instead.');
    });
  };

  const resetSession = () => {
    setMessages([]);
    setAnalytics([]);
    setTeacherContext({ gradeLevel: '', subject: '', experience: '', name: '' });
    setShowSetup(true);
  };

  if (showSetup) {
    return (
      <div className="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-50 flex items-center justify-center p-4">
        <div className="bg-white rounded-2xl shadow-xl p-8 max-w-md w-full">
          <div className="flex items-center justify-center mb-6">
            <div className="text-center">
              <div className="text-3xl font-bold text-gray-800">NGSS</div>
              <div className="text-2xl font-bold text-orange-500">Phenomena</div>
            </div>
          </div>
          <h1 className="text-3xl font-bold text-gray-800 text-center mb-2">
            AI Curriculum Coach
          </h1>
          <p className="text-gray-600 text-center mb-8">
            Your dialogic partner for science teaching excellence
          </p>
          
          <div className="space-y-4">
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                Your Name *
              </label>
              <input
                type="text"
                value={teacherContext.name}
                onChange={(e) => setTeacherContext({...teacherContext, name: e.target.value})}
                className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                placeholder="e.g., Ms. Rodriguez"
              />
            </div>
            
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                Grade Level *
              </label>
              <select
                value={teacherContext.gradeLevel}
                onChange={(e) => setTeacherContext({...teacherContext, gradeLevel: e.target.value})}
                className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
              >
                <option value="">Select grade level</option>
                <option value="Elementary (K-5)">Elementary (K-5)</option>
                <option value="Middle School (6-8)">Middle School (6-8)</option>
                <option value="High School (9-12)">High School (9-12)</option>
              </select>
            </div>
            
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                Subject Focus (Optional)
              </label>
              <input
                type="text"
                value={teacherContext.subject}
                onChange={(e) => setTeacherContext({...teacherContext, subject: e.target.value})}
                className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                placeholder="e.g., Life Science, Physical Science"
              />
            </div>
            
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                Teaching Experience (Optional)
              </label>
              <select
                value={teacherContext.experience}
                onChange={(e) => setTeacherContext({...teacherContext, experience: e.target.value})}
                className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
              >
                <option value="">Select experience level</option>
                <option value="First-year teacher">First-year teacher</option>
                <option value="1-3 years">1-3 years</option>
                <option value="4-7 years">4-7 years</option>
                <option value="8+ years">8+ years</option>
              </select>
            </div>
            
            <button
              onClick={handleSetupComplete}
              disabled={!teacherContext.name || !teacherContext.gradeLevel}
              className="w-full bg-indigo-600 text-white py-3 rounded-lg font-medium hover:bg-indigo-700 disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors"
            >
              Start Coaching Session
            </button>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="flex flex-col h-screen bg-gray-50">
      <div className="bg-white border-b border-gray-200 px-6 py-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center space-x-3">
            <div className="text-center">
              <div className="text-lg font-bold text-gray-800 leading-tight">NGSS</div>
              <div className="text-sm font-bold text-orange-500 leading-tight">Phenomena</div>
            </div>
            <div className="ml-3">
              <h1 className="text-xl font-bold text-gray-800">AI Curriculum Coach</h1>
              <p className="text-sm text-gray-600">
                Coaching {teacherContext.name} • {teacherContext.gradeLevel}
              </p>
            </div>
          </div>
          <div className="flex items-center space-x-2">
            {uploadedDoc && (
              <div className="flex items-center space-x-2 px-3 py-2 bg-blue-50 border border-blue-200 rounded-lg">
                <span className="text-xs text-blue-700 font-medium">📄 {uploadedDoc.name}</span>
                <button
                  onClick={removeDocument}
                  className="text-blue-700 hover:text-blue-900 text-xs"
                  title="Remove document"
                >
                  ✕
                </button>
              </div>
            )}
            <button
              onClick={() => fileInputRef.current?.click()}
              className="flex items-center space-x-2 px-4 py-2 bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition-colors"
              title="Upload curriculum unit"
            >
              <span className="text-sm font-medium">📎 Upload Unit</span>
            </button>
            <input
              ref={fileInputRef}
              type="file"
              onChange={handleFileUpload}
              accept=".pdf,.doc,.docx,.txt"
              style={{ display: 'none' }}
            />
            <button
              onClick={() => setShowPasteArea(!showPasteArea)}
              className="flex items-center space-x-2 px-4 py-2 bg-purple-100 text-purple-700 rounded-lg hover:bg-purple-200 transition-colors"
              title="Paste curriculum content"
            >
              <FileText className="w-4 h-4" />
              <span className="text-sm font-medium">Paste Content</span>
            </button>
            <button
              onClick={shareDataForResearch}
              disabled={analytics.length === 0}
              className="flex items-center space-x-2 px-4 py-2 bg-green-100 text-green-700 rounded-lg hover:bg-green-200 disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed transition-colors"
              title="Share your usage data to help improve this tool for educators"
            >
              <BarChart3 className="w-4 h-4" />
              <span className="text-sm font-medium">Share Pilot Data</span>
            </button>
            <button
              onClick={downloadAnalytics}
              disabled={analytics.length === 0}
              className="flex items-center space-x-2 px-4 py-2 bg-indigo-100 text-indigo-700 rounded-lg hover:bg-indigo-200 disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed transition-colors"
            >
              <BarChart3 className="w-4 h-4" />
              <span className="text-sm font-medium">Export for Me</span>
            </button>
            <button
              onClick={resetSession}
              className="flex items-center space-x-2 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors"
            >
              <RefreshCw className="w-4 h-4" />
              <span className="text-sm font-medium">New Session</span>
            </button>
          </div>
        </div>
      </div>

      <div className="flex-1 overflow-y-auto px-6 py-4 space-y-4">
        {messages.map((message, index) => (
          <div
            key={index}
            className={`flex ${message.role === 'teacher' ? 'justify-end' : 'justify-start'}`}
          >
            <div
              className={`max-w-3xl rounded-2xl px-6 py-4 ${
                message.role === 'teacher'
                  ? 'bg-indigo-600 text-white'
                  : message.role === 'system'
                  ? 'bg-blue-50 border border-blue-200 text-blue-900'
                  : 'bg-white border border-gray-200 text-gray-800'
              }`}
            >
              <div className="flex items-start space-x-3">
                {message.role === 'coach' && (
                  <Lightbulb className="w-5 h-5 text-indigo-600 mt-1 flex-shrink-0" />
                )}
                <p className="text-sm leading-relaxed whitespace-pre-wrap">
                  {message.content}
                </p>
              </div>
            </div>
          </div>
        ))}
        
        {isTyping && (
          <div className="flex justify-start">
            <div className="bg-white border border-gray-200 rounded-2xl px-6 py-4">
              <div className="flex items-center space-x-2">
                <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{animationDelay: '0ms'}}></div>
                <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{animationDelay: '150ms'}}></div>
                <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{animationDelay: '300ms'}}></div>
              </div>
            </div>
          </div>
        )}
        <div ref={messagesEndRef} />
      </div>

      <div className="bg-white border-t border-gray-200 px-6 py-4">
        {showPasteArea && (
          <div className="max-w-4xl mx-auto mb-4 p-4 bg-purple-50 border border-purple-200 rounded-lg">
            <div className="flex items-start justify-between mb-2">
              <div>
                <p className="text-sm font-medium text-purple-900">Paste Curriculum Content</p>
                <p className="text-xs text-purple-700 mt-1">Copy text from your curriculum document and paste it here</p>
              </div>
              <button
                onClick={() => setShowPasteArea(false)}
                className="text-purple-700 hover:text-purple-900 text-sm"
              >
                ✕
              </button>
            </div>
            <textarea
              value={pasteContent}
              onChange={(e) => setPasteContent(e.target.value)}
              placeholder="Paste your curriculum unit content here... (lessons, objectives, activities, etc.)"
              className="w-full px-3 py-2 border border-purple-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none text-sm"
              rows="8"
            />
            <button
              onClick={handlePasteContent}
              disabled={!pasteContent.trim()}
              className="mt-2 px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors text-sm font-medium"
            >
              Load Curriculum Content
            </button>
          </div>
        )}
        {uploadedDoc && (
          <div className="max-w-4xl mx-auto mb-3 p-3 bg-blue-50 border border-blue-200 rounded-lg">
            <div className="flex items-start justify-between">
              <div>
                <p className="text-sm font-medium text-blue-900">Curriculum Unit Loaded</p>
                <p className="text-xs text-blue-700 mt-1">Ask questions like: "Summarize this unit" • "Help me modify lesson 3" • "Draft a parent email" • "Explain the science concepts"</p>
              </div>
            </div>
          </div>
        )}
        <div className="max-w-4xl mx-auto">
          <div className="flex items-end space-x-3">
            <div className="flex-1">
              <textarea
                value={input}
                onChange={(e) => setInput(e.target.value)}
                onKeyPress={(e) => {
                  if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    handleSend();
                  }
                }}
                placeholder="Share your thoughts, questions, or challenges..."
                className="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none"
                rows="3"
              />
            </div>
            <button
              onClick={handleSend}
              disabled={!input.trim()}
              className="bg-indigo-600 text-white p-3 rounded-xl hover:bg-indigo-700 disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors"
            >
              <Send className="w-5 h-5" />
            </button>
          </div>
          <div className="mt-3 flex items-center justify-between text-xs text-gray-500">
            <p>Press Enter to send, Shift+Enter for new line</p>
            <p>{analytics.length} interactions logged</p>
          </div>
        </div>
      </div>
    </div>
  );
};

export default NGSSAICoach;
